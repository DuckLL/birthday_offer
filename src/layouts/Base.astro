---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  nav?: 'r' | 's' | 'my';
}
const { title, description = '整理全台餐廳與商店的壽星生日優惠：可依地區、類型、平台篩選，看地圖，並標記想吃、吃過與預計日期。', nav } = Astro.props;
const SITE = 'DuckLL 的壽星優惠攻略';
const fullTitle = title ? `${title}｜${SITE}` : `${SITE}｜全台生日優惠整理與地圖`;
const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="author" content="DuckLL" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#df4f37" />
    <script is:inline>
      try {
        const t = localStorage.getItem('hbd:theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M4 21h16M5 21v-7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7M5 16c1.2 1 2.3 1 3.5 0s2.3-1 3.5 0 2.3 1 3.5 0 2.3-1 3.5 0M12 12V8M12 5.5c.8-.6.8-1.6 0-2.5-.8.9-.8 1.9 0 2.5Z"
            ></path></svg
          >
          <span>DuckLL<span class="brand-sub"> 的壽星優惠攻略</span></span>
        </a>
        <nav class="nav" aria-label="主選單">
          <a href="/" aria-current={nav === 'r' ? 'page' : undefined}>餐廳</a>
          <a href="/shops/" aria-current={nav === 's' ? 'page' : undefined}>商店</a>
          <a href="/my/" aria-current={nav === 'my' ? 'page' : undefined}>我的清單</a>
        </nav>
        <button class="theme-btn" type="button" id="theme-btn" aria-label="切換深淺色">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
        </button>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <p>優惠內容會變動，請以店家公告為準。店家介紹、地區、分店等資訊為自動蒐集，可能有誤。</p>
        <p>你的「想吃 / 吃過 / 預計日期」只存在這台裝置的瀏覽器裡，換裝置前請到「我的清單」匯出。</p>
        <p>
          發現錯誤？<a href="https://github.com/DuckLL/birthday_offer/issues">到 GitHub 回報</a> · 地圖資料 © OpenStreetMap contributors
        </p>
        <p class="license">
          © {year} <a href="https://github.com/DuckLL">DuckLL</a> · 程式碼採{' '}
          <a href="https://github.com/DuckLL/birthday_offer/blob/main/LICENSE">MIT License</a>{' '}· 優惠資料採{' '}
          <a href="https://creativecommons.org/licenses/by/4.0/deed.zh-hant" rel="license">CC BY 4.0</a> 授權，轉載請註明出處
        </p>
      </div>
    </footer>
    <dialog class="modal" id="detail-modal" aria-label="店家詳細資訊">
      <div class="modal-bar">
        <a class="linkbtn" data-modal-page href="/">開啟完整頁面</a>
        <button type="button" class="modal-close" aria-label="關閉">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
      </div>
      <div class="modal-body"></div>
    </dialog>
    <script>
      import { initModal } from '../scripts/modal';
      import { markStale } from '../scripts/stale';
      markStale();
      initModal();
      document.getElementById('theme-btn')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('hbd:theme', root.dataset.theme);
        } catch {}
      });
    </script>
  </body>
</html>
