---
import Base from '../layouts/Base.astro';
import MarkControls from '../components/MarkControls.astro';
import ColHead from '../components/ColHead.astro';
import ColumnsMenu from '../components/ColumnsMenu.astro';
import StickyFilter from '../components/StickyFilter.astro';
import FilterPop from '../components/FilterPop.astro';
import CheckList from '../components/CheckList.astro';
import RegionSelect from '../components/RegionSelect.astro';
import StatusSelect from '../components/StatusSelect.astro';
import AgeSelect from '../components/AgeSelect.astro';
import { getRestaurants, regionRank, regionText } from '../lib/data';
import { NATIONWIDE, detailUrl, markKey, money } from '../lib/shared';

const { items } = await getRestaurants();
const total = items.reduce((s, r) => s + r.data.value, 0);

const count = (key: (r: (typeof items)[number]) => string | undefined) => {
  const m = new Map<string, number>();
  for (const r of items) {
    const k = key(r);
    if (k) m.set(k, (m.get(k) ?? 0) + 1);
  }
  return [...m].sort((a, b) => b[1] - a[1]);
};
const cats = count((r) => r.data.category);
const plats = count((r) => r.data.platform);
const periods = count((r) => r.data.period);
type Opt = [string, string, number];
const platOpts: Opt[] = [...plats.map(([p, n]): Opt => [p, p, n]), ['-', '未註明', items.filter((r) => !r.data.platform).length]];
const periodOpts: Opt[] = [...periods.map(([p, n]): Opt => [p, `限${p}`, n]), ['-', '當月／未註明', items.filter((r) => !r.data.period).length]];

const pins = items.flatMap((r) =>
  (r.data.locations ?? [])
    .filter((l) => l.lat && l.lng)
    .map((l) => ({
      key: markKey('r', r.id),
      name: r.id,
      branch: l.name,
      address: l.address,
      lat: l.lat,
      lng: l.lng,
      approx: l.approx,
      offer: r.data.offer,
      value: r.data.value,
      url: detailUrl('r', r.id),
    })),
);
const noPin = items.filter((r) => !r.data.locations?.some((l) => l.lat)).map((r) => ({ key: markKey('r', r.id), name: r.id }));
---

<Base nav="r">
  <section class="hero">
    <div>
      <h1>生日快樂！這些店家<em>壽星有優惠</em></h1>
      <p>{items.length} 家餐廳的壽星優惠，全部吃一輪約可省 <b>{money(total)}</b>。可依地區、類型篩選，或切換成地圖看附近的店。</p>
    </div>
    <div class="stats" id="my-stats" aria-live="polite">
      <div class="stat want"><b data-stat="want">0</b><span>想吃</span></div>
      <div class="stat plan"><b data-stat="plan">0</b><span>已排日期</span></div>
      <div class="stat done"><b data-stat="done">0</b><span>吃過</span></div>
      <div class="stat"><b data-stat="saved">$0</b><span>已省下</span></div>
    </div>
  </section>

  <section class="filters" data-kind="r" aria-label="篩選">
    <div class="f-row">
      <label class="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4.2-4.2"></path></svg>
        <span class="sr-only">搜尋</span>
        <input type="search" data-f="q" placeholder="搜尋店名、優惠、備註…" autocomplete="off" />
      </label>
      <RegionSelect />
      <select data-f="sort" aria-label="排序">
        <option value="value-desc">價值高 → 低</option>
        <option value="value-asc">價值低 → 高</option>
        <option value="name-asc">店名</option>
        <option value="updated-desc">最近更新</option>
        <option value="plan-asc">預計日期</option>
      </select>
    </div>
    <div class="chips" role="group" aria-label="類型">
      {
        cats.map(([c, n]) => (
          <button type="button" class="chip-btn" data-f="cat" data-v={c} aria-pressed="false">
            {c}
            <small>{n}</small>
          </button>
        ))
      }
    </div>
    <details class="more">
      <summary>更多篩選 <span class="badge" id="more-badge" hidden></span></summary>
      <div class="more-body">
        <div class="chips" role="group" aria-label="平台">
          <span class="chips-label">平台</span>
          {
            platOpts.map(([v, label, n]) => (
              <button type="button" class="chip-btn" data-f="plat" data-v={v} aria-pressed="false">
                {label}
                <small>{n}</small>
              </button>
            ))
          }
        </div>
        <div class="chips" role="group" aria-label="使用期限">
          <span class="chips-label">期限</span>
          {
            periodOpts.map(([v, label, n]) => (
              <button type="button" class="chip-btn" data-f="period" data-v={v} aria-pressed="false">
                {label}
                <small>{n}</small>
              </button>
            ))
          }
        </div>
        <div class="f-row">
          <StatusSelect kind="r" />
          <AgeSelect />
          <label class="num">價值至少 $<input type="number" data-f="min" min="0" step="100" inputmode="numeric" placeholder="0" /></label>
          <label class="toggle"><input type="checkbox" data-f="free" /> 免消費</label>
          <button type="button" class="linkbtn" data-reset>清除篩選</button>
        </div>
      </div>
    </details>
  </section>

  <StickyFilter placeholder="搜尋店名、優惠、備註…" />

  <div class="resultbar">
    <span id="result-text">顯示 <b>{items.length}</b> 家</span>
    <div class="resultbar-tools">
      <ColumnsMenu />
      <div class="seg" role="group" aria-label="檢視方式">
        <button type="button" data-view="list" aria-pressed="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"></path></svg>列表
        </button>
        <button type="button" data-view="map" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4 3 6.5v13.5L9 17.5l6 2.5 6-2.5V4l-6 2.5L9 4ZM9 4v13.5M15 6.5V20"></path></svg>地圖
        </button>
      </div>
    </div>
  </div>

  <section class="list" id="list" aria-label="餐廳列表">
    <div class="list-head" role="row">
      <ColHead c="name" label="店家" sort="name" />
      <ColHead c="cat" label="類型" sort="cat" filter="cat" />
      <ColHead c="plat" label="平台" sort="plat" filter="plat" />
      <ColHead c="offer" label="優惠" />
      <ColHead c="value" label="價值" sort="value" filter="value" right />
      <ColHead c="period" label="期限" sort="period" filter="period" />
      <ColHead c="region" label="地區" sort="region" filter="region" />
      <ColHead c="updated" label="更新" sort="updated" filter="age" />
      <ColHead c="marks" label="我的標記" sort="plan" filter="status" />
    </div>
    {
      items.map((r) => {
        const d = r.data;
        const regions = d.regions ?? [];
        const q = [r.id, d.category, d.platform, d.offer, d.notes, d.intro, d.period, ...regions].filter(Boolean).join(' ').toLowerCase();
        return (
          <article
            class="item"
            data-key={markKey('r', r.id)}
            data-name={r.id}
            data-cat={d.category}
            data-plat={d.platform ?? '-'}
            data-period={d.period ?? '-'}
            data-value={d.value}
            data-regions={regions.join('|')}
            data-rrank={regionRank(regions)}
            data-updated={d.updated}
            data-free={d.notes?.includes('免消費') ? '1' : undefined}
            data-q={q}
          >
            <div class="c-name" data-c="name">
              <div class="name-line">
                <a href={detailUrl('r', r.id)} title={r.id}>
                  {r.id}
                </a>
                {d.caution && (
                  <span class="warn-dot" title={d.caution}>
                    <svg viewBox="0 0 24 24" aria-label="注意">
                      <path d="M12 3.5 2.5 20h19L12 3.5ZM12 10v4.5M12 17.5h.01" />
                    </svg>
                  </span>
                )}
                <span class="stale-tag" data-stale-show hidden title={`資料更新於 ${d.updated}，可能已過期`}>
                  可能過期
                </span>
              </div>
              {d.intro && <p class="intro">{d.intro}</p>}
            </div>
            <div class="c-cat" data-c="cat">
              <span class="chip">{d.category}</span>
            </div>
            <div class="c-plat" data-c="plat">{d.platform ?? '—'}</div>
            <div class="c-offer" data-c="offer">
              {d.offer}
              {d.notes && <small>{d.notes}</small>}
            </div>
            <div class="c-value" data-c="value">{money(d.value)}</div>
            <div class="c-period" data-c="period">{d.period ? <span class="chip hot">{d.period}</span> : '—'}</div>
            <div class="c-region" data-c="region" title={regions.join('、')}>
              {regionText(regions)}
            </div>
            <div class="c-updated" data-c="updated">
              <time datetime={d.updated}>{d.updated}</time>
            </div>
            <div class="meta-row">
              <span class="chip">{d.category}</span>
              {d.platform && <span class="chip">{d.platform}</span>}
              {d.period && <span class="chip hot">限{d.period}</span>}
              <span class="chip">{regions.includes(NATIONWIDE) ? '全台' : regionText(regions)}</span>
            </div>
            <div class="c-marks" data-c="marks">
              <MarkControls kind="r" id={r.id} />
            </div>
          </article>
        );
      })
    }
    <p class="empty" id="empty" hidden>沒有符合條件的店家，試試清除篩選。</p>
  </section>

  <FilterPop id="cat" title="類型" clear="cat"><CheckList f="cat" options={cats.map(([c, n]) => [c, c, n])} /></FilterPop>
  <FilterPop id="plat" title="平台" clear="plat"><CheckList f="plat" options={platOpts} /></FilterPop>
  <FilterPop id="period" title="使用期限" clear="period"><CheckList f="period" options={periodOpts} /></FilterPop>
  <FilterPop id="value" title="價值" clear="min">
    <label class="num">至少 $<input type="number" data-f="min" min="0" step="100" inputmode="numeric" placeholder="0" /></label>
    <label class="toggle"><input type="checkbox" data-f="free" /> 只看免消費</label>
  </FilterPop>
  <FilterPop id="region" title="地區" clear="region"><RegionSelect /><p class="pop-hint">選縣市時，全台連鎖也會列出</p></FilterPop>
  <FilterPop id="age" title="資料更新" clear="age"><AgeSelect /></FilterPop>
  <FilterPop id="status" title="我的標記" clear="status"><StatusSelect kind="r" /></FilterPop>

  <section class="map-view" id="map-view" hidden aria-label="地圖">
    <div class="map" id="map"></div>
    <div class="map-note">
      <span id="nopin-text"></span>
      <div class="chips" id="nopin"></div>
    </div>
  </section>

  <script type="application/json" id="pins" set:html={JSON.stringify({ pins, noPin })} />

  <script>
    import { initMarkControls } from '../scripts/bind';
    import { initList } from '../scripts/list';
    import { initColumns } from '../scripts/columns';
    import { initStats } from '../scripts/stats';
    initMarkControls();
    initStats();
    initColumns('r');
    initList();
  </script>
</Base>
