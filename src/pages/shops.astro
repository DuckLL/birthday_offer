---
import Base from '../layouts/Base.astro';
import MarkControls from '../components/MarkControls.astro';
import ColHead from '../components/ColHead.astro';
import FilterPop from '../components/FilterPop.astro';
import CheckList from '../components/CheckList.astro';
import RegionSelect from '../components/RegionSelect.astro';
import StatusSelect from '../components/StatusSelect.astro';
import AgeSelect from '../components/AgeSelect.astro';
import { getShops, regionRank, regionText } from '../lib/data';
import { detailUrl, markKey, money, ratioLabel } from '../lib/shared';

const items = await getShops();
const total = items.reduce((s, x) => s + x.data.discount, 0);
const catCount = new Map<string, number>();
for (const s of items) catCount.set(s.data.category, (catCount.get(s.data.category) ?? 0) + 1);
const cats = [...catCount].sort((a, b) => b[1] - a[1]);
---

<Base title="商店生日折價券" nav="s">
  <section class="hero">
    <div>
      <h1>壽星購物<em>折價券</em></h1>
      <p>{items.length} 間商店的生日券，全部用完共折 <b>{money(total)}</b>。「實付比例」是剛好買到低消時等於打幾折，數字越低越划算。</p>
    </div>
    <div class="stats" id="my-stats" aria-live="polite">
      <div class="stat want"><b data-stat="want">0</b><span>想用</span></div>
      <div class="stat plan"><b data-stat="plan">0</b><span>已排日期</span></div>
      <div class="stat done"><b data-stat="done">0</b><span>用過</span></div>
      <div class="stat"><b data-stat="saved">$0</b><span>已折抵</span></div>
    </div>
  </section>

  <section class="filters" data-kind="s" aria-label="篩選">
    <div class="f-row">
      <label class="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4.2-4.2"></path></svg>
        <span class="sr-only">搜尋</span>
        <input type="search" data-f="q" placeholder="搜尋商店…" autocomplete="off" />
      </label>
      <RegionSelect online />
      <select data-f="sort" aria-label="排序">
        <option value="ratio-asc">最划算（實付比例低）</option>
        <option value="value-desc">折抵金額高 → 低</option>
        <option value="min-asc">低消低 → 高</option>
        <option value="name-asc">店名</option>
        <option value="updated-desc">最近更新</option>
        <option value="plan-asc">預計日期</option>
      </select>
      <StatusSelect kind="s" />
      <AgeSelect />
    </div>
    <div class="chips" role="group" aria-label="類型">
      {
        cats.map(([c, n]) => (
          <button type="button" class="chip-btn" data-f="cat" data-v={c} aria-pressed="false">
            {c}
            <small>{n}</small>
          </button>
        ))
      }
    </div>
  </section>

  <div class="resultbar"><span id="result-text"></span></div>

  <section class="list shops" id="list" aria-label="商店列表">
    <div class="list-head" role="row">
      <ColHead label="商店" sort="name" />
      <ColHead label="類型" sort="cat" filter="cat" />
      <ColHead label="低消" sort="min" />
      <ColHead label="折抵" sort="value" />
      <ColHead label="實付比例" sort="ratio" />
      <ColHead label="地區" sort="region" filter="region" />
      <ColHead label="更新" sort="updated" filter="age" />
      <ColHead label="我的標記" sort="plan" filter="status" />
    </div>
    {
      items.map((s) => {
        const d = s.data;
        const regions = d.regions ?? [];
        return (
          <article
            class="item"
            data-key={markKey('s', s.id)}
            data-name={s.id}
            data-cat={d.category}
            data-value={d.discount}
            data-ratio={s.ratio}
            data-min={d.minSpend ?? 0}
            data-regions={regions.join('|')}
            data-rrank={regionRank(regions)}
            data-updated={d.updated}
            data-q={[s.id, d.category, d.intro, d.notes, ...regions].filter(Boolean).join(' ').toLowerCase()}
          >
            <div class="c-name">
              <a href={detailUrl('s', s.id)}>{s.id}</a>
              {d.caution && (
                <span class="warn-dot" title={d.caution}>
                  <svg viewBox="0 0 24 24" aria-label="注意">
                    <path d="M12 3.5 2.5 20h19L12 3.5ZM12 10v4.5M12 17.5h.01" />
                  </svg>
                </span>
              )}
              <span class="stale-tag" data-stale-show hidden title={`資料更新於 ${d.updated}，可能已過期`}>
                可能過期
              </span>
              {d.intro && <p class="intro">{d.intro}</p>}
            </div>
            <div class="c-cat">
              <span class="chip">{d.category}</span>
            </div>
            <div class="c-min">{d.minSpend ? money(d.minSpend) : '無'}</div>
            <div class="c-disc c-value" style="font-size:15px">
              {money(d.discount)}
            </div>
            <div class="c-offer ratio">
              <span>{ratioLabel(s.ratio)}</span>
              <span class="bar" aria-hidden="true">
                <i style={`width:${Math.round((1 - s.ratio) * 100)}%`} />
              </span>
            </div>
            <div class="c-region" title={regions.join('、')}>
              {regionText(regions)}
            </div>
            <div class="c-updated">
              <time datetime={d.updated}>{d.updated}</time>
            </div>
            <div class="meta-row">
              <span class="chip">{d.category}</span>
              <span class="chip">{d.minSpend ? `低消 ${money(d.minSpend)}` : '無低消'}</span>
              <span class="chip hot">折 {money(d.discount)}</span>
              <span class="chip">{regionText(regions)}</span>
            </div>
            <div class="c-marks">
              <MarkControls kind="s" id={s.id} />
            </div>
          </article>
        );
      })
    }
    <p class="empty" id="empty" hidden>沒有符合條件的商店。</p>
  </section>

  <FilterPop id="cat" title="類型" clear="cat"><CheckList f="cat" options={cats.map(([c, n]) => [c, c, n])} /></FilterPop>
  <FilterPop id="region" title="地區" clear="region"><RegionSelect online /><p class="pop-hint">選縣市時，全台連鎖也會列出</p></FilterPop>
  <FilterPop id="age" title="資料更新" clear="age"><AgeSelect /></FilterPop>
  <FilterPop id="status" title="我的標記" clear="status"><StatusSelect kind="s" /></FilterPop>

  <script>
    import { initMarkControls } from '../scripts/bind';
    import { initList } from '../scripts/list';
    import { initStats } from '../scripts/stats';
    initMarkControls();
    initStats();
    initList();
  </script>
</Base>
