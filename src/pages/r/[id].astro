---
import Base from '../../layouts/Base.astro';
import MarkControls from '../../components/MarkControls.astro';
import InfoCards from '../../components/InfoCards.astro';
import { getRestaurants } from '../../lib/data';
import { money } from '../../lib/shared';

export async function getStaticPaths() {
  const { items, platforms } = await getRestaurants();
  return items.map((r) => ({ params: { id: r.id }, props: { r, platform: r.data.platform ? platforms.get(r.data.platform) : undefined } }));
}

const { r, platform } = Astro.props;
const d = r.data;
---

<Base title={`${r.id} 壽星優惠`} description={`${r.id} 生日優惠：${d.offer}，約值 ${money(d.value)}。${d.intro ?? ''}`} nav="r">
  <nav class="crumb"><a href="/">餐廳</a> / {d.category}</nav>
  <div class="detail" data-updated={d.updated}>
    <div>
      <h1>{r.id}</h1>
      <div class="tags">
        <span class="chip">{d.category}</span>
        {d.platform && <span class="chip">{d.platform}</span>}
        {d.period && <span class="chip hot">限{d.period}</span>}
        {d.notes?.includes('免消費') && <span class="chip hot">免消費</span>}
      </div>

      <div class="card">
        <div class="offer-card">
          <div class="o">{d.offer}</div>
          <div class="v">{money(d.value)}<small>約略價值</small></div>
        </div>
        <dl class="kv">
          <dt>使用期限</dt>
          <dd>{d.period ? `限${d.period}` : '生日當月（未特別註明）'}</dd>
          {
            d.notes && (
              <>
                <dt>注意事項</dt>
                <dd>{d.notes}</dd>
              </>
            )
          }
          <dt>領取方式</dt>
          <dd>
            {d.platform ?? '未註明'}
            {platform && <div style="color:var(--muted);font-size:14px">{platform.intro}</div>}
            {
              platform?.url && (
                <a href={platform.url} target="_blank" rel="noopener" style="font-size:14px">
                  {new URL(platform.url).hostname}
                </a>
              )
            }
          </dd>
        </dl>
        {
          d.caution && (
            <p class="notice warn">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3.5 2.5 20h19L12 3.5ZM12 10v4.5M12 17.5h.01" />
              </svg>
              <span>{d.caution}</span>
            </p>
          )
        }
      </div>

      <InfoCards name={r.id} intro={d.intro} regions={d.regions} website={d.website} sources={d.sources} locations={d.locations} updated={d.updated} verified={d.verified} />
    </div>

    <aside class="card" style="position:sticky;top:72px">
      <h2>我的標記</h2>
      <MarkControls kind="r" id={r.id} full />
    </aside>
  </div>
  <script>
    import { initMarkControls } from '../../scripts/bind';
    initMarkControls();
  </script>
</Base>
