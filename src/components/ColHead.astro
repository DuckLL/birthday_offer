---
// 表頭欄位：點名稱排序，漏斗按鈕打開同名的 FilterPop，整格可拖曳調整順序，右緣拖曳調整寬度
interface Props {
  c: string; // 欄位 key，見 lib/columns.ts
  label: string;
  sort?: string;
  filter?: string;
  right?: boolean;
}
const { c, label, sort, filter, right = false } = Astro.props;
---

<div class:list={['th', { right }]} role="columnheader" data-c={c} data-col={sort} draggable="true" title="拖曳可調整欄位順序">
  {
    sort ? (
      <button type="button" class="th-sort" data-sort-col={sort} title={`依${label}排序`}>
        <span class="th-label">{label}</span>
        <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m8 10 4-4 4 4M8 14l4 4 4-4" />
        </svg>
      </button>
    ) : (
      <span class="th-label">{label}</span>
    )
  }
  {
    filter && (
      <button type="button" class="th-filter" popovertarget={`pop-${filter}`} data-filter-btn={filter} aria-label={`篩選${label}`} title={`篩選${label}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 5h16l-6 7.5V19l-4-2v-4.5L4 5Z" />
        </svg>
      </button>
    )
  }
  <span class="col-resize" data-resize={c} title="拖曳調整寬度，雙擊恢復" aria-hidden="true"></span>
</div>
